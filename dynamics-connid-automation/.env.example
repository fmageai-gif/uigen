# Copy to .env and fill in. .env is gitignored — never commit real values.
# No credentials belong in here: authentication comes from the Playwright
# storage_state file produced by save_auth.py.

# --- Authentication ---------------------------------------------------------
# Path to the saved Playwright session (cookies + local storage).
# Created by: python save_auth.py
PLAYWRIGHT_STORAGE_STATE=auth_state.json

# --- URLs -------------------------------------------------------------------
# Default Dynamics 365 case record URL, used when no case_url is passed on the
# command line. Customer Service Workspace deep link, e.g.
# https://<org>.crm.dynamics.com/main.aspx?appid=<app-guid>&pagetype=entityrecord&etn=incident&id=<case-guid>
DYNAMICS_CASE_URL=

# Where save_auth.py sends you to sign in to Dynamics. Any authenticated page of
# the org works; defaults to DYNAMICS_CASE_URL when left blank.
DYNAMICS_LOGIN_URL=

# The SharePoint-hosted ADHOC.xlsx workbook (Excel for the web).
EXCEL_WORKBOOK_URL=https://cnxmail.sharepoint.com/:x:/r/sites/msteams_e5fb5e-HPLegacyLOB2/_layouts/15/Doc.aspx?sourcedoc=%7BC1183814-7BAB-4E5F-93C9-89CE1943BDE0%7D&file=ADHOC.xlsx&action=default&mobileredirect=true&isSPOFile=1&CID=51649E99-80AA-4ED2-92EB-62BB7F74D06F

# --- Workbook layout --------------------------------------------------------
# 1-based row number that holds the column headers.
EXCEL_HEADER_ROW=1

# --- Browser / logging ------------------------------------------------------
# true runs without a visible window; set false (or pass --headed) to watch it.
HEADLESS=true

# Milliseconds of delay per Playwright action — handy when debugging.
SLOW_MO=0

# Default wait for elements, in milliseconds.
DEFAULT_TIMEOUT_MS=45000

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional: directory for failure screenshots. Leave blank to disable.
SCREENSHOT_DIR=

# Optional: path to an existing Chromium/Chrome binary, for machines where
# `playwright install` cannot download its own browser. Leave blank to use
# Playwright's bundled Chromium.
PLAYWRIGHT_EXECUTABLE_PATH=
